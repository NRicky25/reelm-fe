# Copy to .env.local and fill in.

# Use the reelm-be API (remove or comment out to use the built-in fake data)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Pin "today" (keep equal to CATALOG_TODAY in reelm-be/.env). Remove for real dates.
NEXT_PUBLIC_CATALOG_TODAY=2026-11-08

# Your Supabase project URL (public, not a secret), e.g. https://abcd1234.supabase.co
# Images are only allowed from its `images` bucket. Never put any Supabase *key* here.
IMAGES_SUPABASE_URL=
