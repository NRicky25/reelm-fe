# Copy to .env.local and fill in.

# Use the reelm-be API (remove or comment out to use the built-in fake data)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Pin "today" (keep equal to CATALOG_TODAY in reelm-be/.env). Remove for real dates.
NEXT_PUBLIC_CATALOG_TODAY=2026-11-08

# The media server's public address (self-hosted media folder behind the
# Cloudflare Tunnel). Images are only allowed from its /images/ folder.
IMAGES_MEDIA_URL=https://media.reelm.site
